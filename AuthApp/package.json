  "scripts": {
    "test": "test",
    "build": "tsc",
    "typeorm:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d ./scripts/generate-migration-data-source.ts",
    "typeorm:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js  migration:run -d ./scripts/generate-migration-data-source.ts",
    "migration:generate": "bash ./scripts/generate-migration.sh",
    "migration:generate:win": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-migration.ps1",
    "migration:run": "npm run typeorm:run",
    "start:dev": "npm run build && cross-env NODE_ENV=local ts-node-dev src/server.ts"
  },
