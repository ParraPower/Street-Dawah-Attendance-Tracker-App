{
  "name": "street-dawah-auth-api",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "test",
    "build": "tsc",

    "typeorm:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js  migration:generate -d ./src/data/data-source.ts",
    "typeorm:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js  migration:run -d ./scripts/migration-data-source.ts",

    "migration:generate": "sh ./scripts/generate-migration.sh",
    "migration:generate:win": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-migration.ps1",
    "migration:run": "sh ./scripts/run-migration.sh",
    "migration:run:win": "powershell -ExecutionPolicy Bypass -File ./scripts/run-migration.ps1",
    "migration:revert": "sh ./scripts/revert-migration.sh",
    "migration:revert:win": "powershell -ExecutionPolicy Bypass -File ./scripts/revert-migration.ps1",

    "start:local": "npm run build && cross-env NODE_ENV=local ts-node-dev -r tsconfig-paths/register src/server.ts",
    "start:dev": "npm run build && cross-env NODE_ENV=develop ts-node-dev -r tsconfig-paths/register src/server.ts",

    "admin:password:hash": "ts-node -r tsconfig-paths/register ./scripts/generate-password-hash.ts",

    "docker:db:local": "docker compose -f docker-compose.local.yml --env-file .env.local up --build -d postgres",
    "docker:db:dev": "docker compose -f docker-compose.dev.yml --env-file .env.development up --build -d postgres",
    "docker:db:prod": "docker compose -f docker-compose.prod.yml --env-file .env.production up --build -d postgres",

    "docker:start": "powershell -ExecutionPolicy Bypass -File ./scripts/docker-run.ps1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@automapper/classes": "^8.8.1",
    "@automapper/core": "^8.8.1",
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.10",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "@street-dawah/app-framework": "file:../StreetDawahAppFramework"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.21",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "reflect-metadata": "^0.2.2"
  }
}
