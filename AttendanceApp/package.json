    "@automapper/classes": "^8.8.1",
    "@automapper/core": "^8.8.1",
    "@types/morgan": "^1.9.10",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.0",
    "lodash": "^4.17.23",
    "morgan": "^1.10.1",
    "multer": "2.1.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "xlsx": "^0.18.5",
    "@street-dawah/app-framework": "file:../StreetDawahAppFramework"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.2.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "reflect-metadata": "^0.2.2"
  },
  "scripts": {
    "test": "npm jest",
    "build": "tsc",
    "typeorm:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js  migration:generate -d ./src/data/data-source.ts",
    "typeorm:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js  migration:run -d ./scripts/migration-data-source.ts",

    "migration:generate": "bash ./scripts/generate-migration.sh",
    "migration:generate:win": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-migration.ps1",
    "migration:run": "sh ./scripts/run-migration.sh",
    "migration:run:win": "powershell -ExecutionPolicy Bypass -File ./scripts/run-migration.ps1",
    "migration:revert": "npm run typeorm:revert",
    "migration:revert:win": "powershell -ExecutionPolicy Bypass -File ./scripts/revert-migration.ps1",

    "docker:start": "powershell -ExecutionPolicy Bypass -File ./scripts/docker-run.ps1",

    "start:local": "npm run build && cross-env NODE_ENV=local ts-node-dev -r tsconfig-paths/register src/server.ts"
  },
