{
    "extends": "@tsconfig/node20/tsconfig.json",
    "compilerOptions": {
      "outDir": "./dist",
      "rootDir": "./src",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "target": "ES2022",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,  
      "allowSyntheticDefaultImports": true

    },
     "paths": {
      "@/*": ["./*"]
    },
    "include": ["src/**/*", "env.d.ts"],
    "ts-node": {
      "esm": true,//"migration:generate": "cross-env NODE_ENV=local dotenv -e .env.local npm run chuck:local", 
    }
  }
  