{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@auth/*": ["AuthApp/src/*"],
      "@shared/*": ["StreetDawahAppFramework/dist/*"]
    }
  }
}
