{
    "extends": "@tsconfig/node20/tsconfig.json",
    "compilerOptions": {
      "outDir": "./dist",
      "rootDir": "./src",
      "module": "commonjs",
      "target": "es2020",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,  
    },
    "include": ["src/**/*", "env.d.ts"]
  }
  