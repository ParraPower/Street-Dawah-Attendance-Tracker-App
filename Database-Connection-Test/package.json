{
  "name": "database-connection-test",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "cross-env NODE_ENV=local dotenv -e .env.local ts-node src/index.ts",
    "typeorm": "ts-node --transpile-only ./node_modules/typeorm/cli.js",
